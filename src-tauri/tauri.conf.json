{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orvia",
  "version": "0.1.0",
  "identifier": "space.zeze49024.orvia",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5174 --strictPort",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orvia",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 680,
        "decorations": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A local personal knowledge library",
    "publisher": "zeze49024",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English"
        ],
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MUQ2REQ1NDJBMzc4MEMKUldRTWVLTkMxVzBkTmVYWmVmMmp0L0N2SlVmNmU1bGdpZmxxNHpSU0YxVTVuTklhQW1yeUJJeTUK",
      "endpoints": [
        "https://raw.githubusercontent.com/zeze49024/orvia-windows/main/updates/windows/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
