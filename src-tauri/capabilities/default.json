{
  "identifier": "main-window",
  "description": "Only the main local application window can access its selected files and window controls.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-write-file",
    "updater:default"
  ]
}
